[
  {
    "name": "RetroArch",
    "platforms": [ "NES", "SNES", "Game Boy", "GBC", "GBA", "NDS", "N64", "Mega Drive", "Master System", "Game Gear", "PC Engine", "PlayStation", "PSP", "Virtual Boy", "街机" ],
    "extensions": [ ".nes", ".sfc", ".smc", ".gb", ".gbc", ".gba", ".nds", ".n64", ".z64", ".v64", ".md", ".gen", ".sms", ".gg", ".pce", ".cue", ".chd", ".iso", ".pbp", ".vb", ".zip" ],
    "argsTemplate": "-L \"{core}\" \"{rom}\"",
    "corePath": "",
    "githubRepo": "libretro/RetroArch",
    "notes": "需把对应核心 dll 放到 cores 目录，并在配置里填写核心相对路径（如 cores\\snes9x_libretro.dll）。"
  },
  {
    "name": "Dolphin",
    "platforms": [ "GameCube", "Wii" ],
    "extensions": [ ".iso", ".gcm", ".rvz", ".wbfs", ".dol", ".elf" ],
    "argsTemplate": "-b -e \"{rom}\"",
    "corePath": "",
    "githubRepo": "dolphin-emu/dolphin",
    "notes": "GameCube/Wii 模拟器。"
  },
  {
    "name": "PCSX2",
