[
  {
    "name": "RetroArch",
    "platforms": [ "NES", "SNES", "N64", "Game Boy", "GBC", "GBA", "NDS", "Mega Drive", "Master System", "Game Gear", "PC Engine", "PlayStation", "PSP", "Saturn", "Dreamcast", "Virtual Boy", "街机" ],
    "extensions": [ ".nes", ".sfc", ".smc", ".gb", ".gbc", ".gba", ".nds", ".n64", ".z64", ".v64", ".md", ".gen", ".sms", ".gg", ".pce", ".cue", ".chd", ".iso", ".pbp", ".vb", ".zip" ],
    "argsTemplate": "-L \"{core}\" \"{rom}\"",
    "corePath": "",
    "githubRepo": "",
    "websiteUrl": "https://www.retroarch.com/?page=platforms",
    "notes": "需把对应核心 dll 放到 cores 目录，并在「设置 → 平台」里选核心；Windows 包请从官网 / Buildbot 手动更新。"
  },
  {
    "name": "Dolphin",
    "platforms": [ "GameCube", "Wii" ],
    "extensions": [ ".iso", ".gcm", ".rvz", ".wbfs", ".dol", ".elf" ],
    "argsTemplate": "-b -e \"{rom}\"",
    "corePath": "",
    "githubRepo": "",
    "websiteUrl": "https://dolphin-emu.org/download/",
    "notes": "GameCube / Wii 模拟器；版本请从官网下载（GitHub 仓库没有 Windows Release 资产）。"
  },
  {
    "name": "PCSX2",
    "platforms": [ "PS2" ],
    "extensions": [ ".iso", ".chd", ".bin", ".cue" ],
    "argsTemplate": "\"{rom}\" --fullscreen",
    "corePath": "",
    "githubRepo": "PCSX2/pcsx2",
    "notes": "PS2 模拟器；需要自备 BIOS。"
  },
  {
    "name": "PPSSPP",
    "platforms": [ "PSP" ],
    "extensions": [ ".iso", ".cso", ".pbp", ".chd" ],
    "argsTemplate": "\"{rom}\"",
    "corePath": "",
    "githubRepo": "hrydgard/ppsspp",
    "notes": "PSP 模拟器。"
  },
  {
    "name": "DuckStation",
    "platforms": [ "PlayStation" ],
    "extensions": [ ".cue", ".bin", ".chd", ".pbp", ".iso" ],
    "argsTemplate": "\"{rom}\"",
    "corePath": "",
    "githubRepo": "stenzek/duckstation",
    "notes": "PS1 模拟器；需要自备 BIOS 才能获得最佳兼容性。"
  },
  {
    "name": "RPCS3",
    "platforms": [ "PS3" ],
    "extensions": [ ".iso", ".pkg", ".elf", ".self" ],
    "argsTemplate": "\"{rom}\"",
    "corePath": "",
    "githubRepo": "RPCS3/rpcs3-binaries-win",
    "notes": "PS3 模拟器；需要额外固件；更新来自 RPCS3 官方 Windows 构建仓库。"
  },
  {
    "name": "Cemu",
    "platforms": [ "Wii U" ],
    "extensions": [ ".wud", ".wux", ".wua", ".rpx", ".elf" ],
    "argsTemplate": "-g \"{rom}\"",
    "corePath": "",
    "githubRepo": "Cemu-project/Cemu",
    "notes": "Wii U 模拟器；图形包、密钥与系统文件需自行配置。"
  },
  {
    "name": "Xenia Canary",
    "platforms": [ "Xbox 360" ],
