<UserControl x:Class="MicaRomManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MicaRomManager.Views"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="13"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- 只留内容区，页签头由左侧两级导航代替 -->
        <Style x:Key="SettingsContentOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 苹果风导航项：圆角胶囊、左右各留 8，选中用强调色淡底 -->
        <Style x:Key="SettingsMenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsMenuListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsMenuItemStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- 行与行之间的极淡分隔线：压在行的底部空隙里 -->
        <Style x:Key="SettingsRowLineStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Fill" Value="{DynamicResource HairlineBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：返回按钮 + 标题（设置现在是主窗口里的一页，不再自己开窗） -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Button Content="← 返回" Padding="10,5" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Back_Click" ToolTip="回到游戏库（Esc）" />
                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 一级：分类（带图标） -->
            <Border Grid.Column="0" Background="{DynamicResource ShellPanelBrush}">
                <ListBox x:Name="CategoryList" Style="{StaticResource SettingsMenuListStyle}"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13" Width="22" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource HairlineBrush}" />

            <!-- 二级：该分类下的页；只有一个页时整列收起 -->
            <Grid x:Name="PaneColumnHost" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="1" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource HairlineBrush}" />
                <Border Grid.Column="1" Background="{DynamicResource ShellPanelBrush}">
                    <ListBox x:Name="PaneList" Style="{StaticResource SettingsMenuListStyle}"
                             SelectionChanged="PaneList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource HairlineBrush}" />
            </Grid>

            <TabControl x:Name="SettingsTabs" Grid.Column="3" Margin="0"
                        Style="{StaticResource SettingsContentOnlyTabControlStyle}"
                        ItemContainerStyle="{StaticResource SettingsTabItemStyle}">

            <!-- 常规 · 库与导入 -->
            <TabItem Header="库与导入" Tag="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="库与导入" Style="{StaticResource SettingsPageTitleStyle}" />
                                <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                           Text="决定导入时文件是链接、复制还是移动，以及库目录放在哪里。" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="保存常规设置" Width="130" VerticalAlignment="Top"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveGeneral_Click" />
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" MaxWidth="620" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="导入策略" Style="{StaticResource SettingsRowLabelStyle}" />
                                <ComboBox x:Name="ImportModeCombo" Grid.Row="0" Grid.Column="1"
                                          Width="340" HorizontalAlignment="Left" MinHeight="32" Margin="0,0,0,14">
                                    <ComboBoxItem Content="仅链接（只记录路径，不移动、不复制）" />
                                    <ComboBoxItem Content="复制到库目录后入库" />
                                    <ComboBoxItem Content="移动到库目录后入库" />
                                </ComboBox>
                                <Rectangle Grid.Row="0" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="1" Text="库目录" Style="{StaticResource SettingsRowLabelStyle}" />
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LibraryRootBox" />
                                    <Button Grid.Column="1" Content="浏览…" Margin="12,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseLibraryRoot_Click" />
                                </Grid>

                                <Rectangle Grid.Row="1" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="2" Text="选项" Style="{StaticResource SettingsRowLabelStyle}" />
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <CheckBox x:Name="PortableModeCheck"
                                              Content="便携模式（库目录为程序目录下的相对路径）" />
                                    <CheckBox x:Name="AssistantDefaultCheck" Margin="0,10,0,0"
                                              Content="启动时展开米卡助手" />
                                    <TextBlock Style="{StaticResource SettingsHintStyle}"
                                               Text="便携模式要求 exe 与库文件夹在同一盘；开启后库目录、ROM / 碟片 / 封面与模拟器路径都存相对路径，换机器换盘符仍可用。" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 常规 · 显示 -->
            <TabItem Header="显示" Tag="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="显示" Style="{StaticResource SettingsPageTitleStyle}" />
                            <Button Grid.Column="1" Content="保存常规设置" Width="130" VerticalAlignment="Top"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveGeneral_Click" />
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupDescStyle}"
                                           Text="只影响界面显示；库里始终存平台短名，换习惯不改数据。" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" MaxWidth="620" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="主机命名" Style="{StaticResource SettingsRowLabelStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ComboBox x:Name="PlatformNamingCombo" Width="340"
                                                  HorizontalAlignment="Left" MinHeight="32">
                                            <ComboBoxItem Content="日式（Famicom / Super Famicom）" />
                                            <ComboBoxItem Content="欧美（NES / SNES）" />
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource SettingsHintStyle}" MaxWidth="560"
                                                   Text="FC/NES、SFC/SNES、PCE、MD 这些日欧美叫法不同的主机按这里的习惯显示（日式：Famicom、Super Famicom、PC Engine、Mega Drive；欧美：NES、SNES、TurboGrafx-16、Genesis），左侧平台栏、游戏表格与设置页一起变。" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 常规 · 网络 -->
            <TabItem Header="网络" Tag="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="网络" Style="{StaticResource SettingsPageTitleStyle}" />
                                <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                           Text="代理同时作用于检查更新、模拟器下载与 AI 请求。" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="保存常规设置" Width="130" VerticalAlignment="Top"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveGeneral_Click" />
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" MaxWidth="620" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="代理模式" Style="{StaticResource SettingsRowLabelStyle}" />
                                <ComboBox x:Name="ProxyModeCombo" Grid.Row="0" Grid.Column="1"
                                          Width="220" HorizontalAlignment="Left" MinHeight="32" Margin="0,0,0,14"
                                          SelectionChanged="ProxyMode_Changed">
                                    <ComboBoxItem Content="不使用代理" />
                                    <ComboBoxItem Content="跟随系统代理" />
                                    <ComboBoxItem Content="手动代理" />
                                </ComboBox>
                                <Rectangle Grid.Row="0" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="1" Text="代理地址" Style="{StaticResource SettingsRowLabelStyle}" />
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProxyAddressBox"
                                                 ToolTip="格式：host:port，例如 127.0.0.1:7890（仅手动代理时生效）" />
                                        <Button Grid.Column="1" Content="测试 GitHub 连接" Margin="12,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="TestNetwork_Click" />
                                    </Grid>
                                    <TextBlock x:Name="NetworkTestText" Style="{StaticResource SettingsHintStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 模拟器管理 -->
            <TabItem x:Name="EmulatorTab" Header="模拟器管理" Tag="模拟器">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="28,20,28,0">
                        <TextBlock Text="模拟器管理" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="按内置模板安装、校验路径、从 GitHub 检查更新；平台绑定在「平台」页里配。" />
                    </StackPanel>
                    <!-- 内容按需构造：打开设置不再解析整套模拟器界面 -->
                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0"
                            Margin="28,16,28,22">
                        <ContentControl x:Name="EmulatorTabHost" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- 字典库 -->
            <TabItem Header="字典库" Tag="字典库">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="28,20,28,0">
                        <TextBlock Text="字典库" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="筛选栏与编辑表单里的候选值。改名会同步已有记录，仍被引用的值不能删除。" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0"
                            Margin="28,16,28,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Column="0" Margin="10,14,10,14">
                                <TextBlock DockPanel.Dock="Top" Text="字段" Margin="10,0,0,10"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ListBox x:Name="LookupKindList"
                                         SelectionChanged="LookupKindList_SelectionChanged" />
                            </DockPanel>

                            <Border Grid.Column="1" Width="1" Margin="0,14"
                                    Background="{DynamicResource HairlineBrush}" />

                            <DockPanel Grid.Column="2" Margin="20,14,20,12">
                                <TextBlock DockPanel.Dock="Top" Text="值" Margin="0,0,0,10"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ListBox x:Name="LookupValueList"
                                         MouseDoubleClick="LookupValueList_MouseDoubleClick"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBox Width="220" MinHeight="26" VerticalContentAlignment="Center"
                                                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Content="✓" Width="28" Height="26" Margin="6,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Tag="{Binding}" Click="LookupInlineCommit_Click" />
                                                    <Button Content="✕" Width="28" Height="26" Margin="4,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Tag="{Binding}" Click="LookupInlineCancel_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Grid Grid.Row="1" Grid.Column="2" Margin="20,0,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="添加" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="AddLookupValue_Click" />
                                    <Button Content="编辑" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RenameLookupValue_Click" />
                                    <Button Content="删除" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RemoveLookupValue_Click" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SettingsHintStyle}"
                                           Text="双击或点「编辑」原地录入，✓ 保存、✕ 取消。" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 平台设置 -->
            <TabItem Header="平台设置" Tag="平台">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="28,20,28,0">
                        <TextBlock Text="平台设置" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="每个平台的默认模拟器、库内子目录、ROM 格式、RetroArch 核心与启动参数；先选厂商再选主机，点「编辑排序」用 ↑ ↓ 调整顺序。" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0"
                            Margin="28,16,28,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="8,14,8,12">
                                <TextBlock DockPanel.Dock="Top" Text="厂商" Margin="10,0,0,8"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ListBox x:Name="VendorList" SelectionChanged="VendorList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel MinWidth="100">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}"
                                                           Margin="8,0,0,0" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Border Grid.Column="1" Width="1" Margin="0,14"
                                    Background="{DynamicResource HairlineBrush}" />

                            <DockPanel Grid.Column="2" Margin="10,14,10,12">
                                <TextBlock DockPanel.Dock="Top" Text="主机" Margin="10,0,0,8"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OrderEditButton" Content="编辑排序" HorizontalAlignment="Left"
                                            Padding="12,5" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="TogglePlatformOrderEdit_Click"
                                            ToolTip="进入编辑模式后用 ↑ ↓ 调整顺序，只在当前厂商内生效" />
                                    <Button Grid.Column="1" Content="恢复默认" Padding="10,5"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ResetPlatformOrder_Click"
                                            ToolTip="按「厂商 → 首发年代」重排" />
                                </Grid>
                                <ListBox x:Name="PlatformList" SelectionChanged="PlatformList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel MinWidth="120">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="↑" Tag="{Binding}" Click="MovePlatformUp_Click"
                                                            Width="22" Height="22" Padding="0" FontSize="11"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="上移" />
                                                    <Button Content="↓" Tag="{Binding}" Click="MovePlatformDown_Click"
                                                            Width="22" Height="22" Padding="0" FontSize="11"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="下移" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Border Grid.Column="3" Width="1" Margin="0,14"
                                    Background="{DynamicResource HairlineBrush}" />

                            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20,14,20,18" MaxWidth="600" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PlatformNameText" VerticalAlignment="Center"
                                                   Style="{StaticResource SettingsGroupTitleStyle}"
                                                   FontSize="16" Text="（未选择平台）" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="重命名…" Padding="10,4" FontSize="12"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="RenamePlatform_Click"
                                                    ToolTip="改主机短名，游戏记录与模拟器绑定会一起改" />
                                            <Button Content="删除" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeletePlatform_Click"
                                                    ToolTip="只删这个平台的配置；库里还有该平台的游戏时会拒绝" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="默认模拟器" Style="{StaticResource SettingsRowLabelStyle}" Margin="0,16,0,6" />
                                    <ComboBox x:Name="PlatformEmulatorCombo" Width="280" HorizontalAlignment="Left"
                                              MinHeight="32" SelectionChanged="PlatformEmulator_Changed" />

                                    <StackPanel x:Name="PlatformCorePanel" Visibility="Collapsed" Margin="0,16,0,0">
                                        <TextBlock Text="RetroArch 核心" Style="{StaticResource SettingsRowLabelStyle}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="PlatformCoreCombo" Width="320" HorizontalAlignment="Left" MinHeight="32" />
                                        <TextBlock Style="{StaticResource SettingsHintStyle}" MaxWidth="460"
                                                   Text="从模拟器安装目录的 cores 文件夹读取；不选则使用模拟器自带核心。" />
                                    </StackPanel>

                                    <TextBlock Text="库内子文件夹" Style="{StaticResource SettingsRowLabelStyle}" Margin="0,16,0,6" />
                                    <TextBox x:Name="PlatformFolderBox" Width="280" HorizontalAlignment="Left"
                                             ToolTip="复制 / 移动入库时使用的子文件夹名，留空则用平台名" />

                                    <TextBlock Text="支持的 ROM 格式" Style="{StaticResource SettingsRowLabelStyle}" Margin="0,16,0,6" />
                                    <TextBox x:Name="PlatformFormatsBox" Width="360" HorizontalAlignment="Left"
                                             ToolTip="空格或逗号分隔，如 iso cue bin chd pbp；留空表示不限制" />
                                    <TextBlock Style="{StaticResource SettingsHintStyle}" MaxWidth="460"
                                               Text="扫描该平台子库时只识别这些扩展名；导入时用于自动识别平台。留空表示不限制。" />

                                    <TextBlock Text="额外启动参数" Style="{StaticResource SettingsRowLabelStyle}" Margin="0,16,0,6" />
                                    <TextBox x:Name="PlatformArgsBox" HorizontalAlignment="Stretch"
                                             ToolTip="可选，会追加在模拟器默认参数之后；占位符：{rom} {romdir} {romname} {core}" />
                                    <TextBlock Style="{StaticResource SettingsHintStyle}" MaxWidth="460"
                                               Text="只填额外参数（如 --fullscreen），程序会拼在模拟器默认参数后面；留空则完全使用模拟器默认参数。" />

                                    <WrapPanel Margin="0,18,0,0">
                                        <Button Content="保存平台设置" Width="120" Margin="0,0,8,8"
                                                Style="{StaticResource PrimaryButtonStyle}" Click="SavePlatform_Click" />
                                        <Button x:Name="ScanPlatformButton" Content="扫描库目录…" Margin="0,0,8,8"
                                                ToolTip="扫描该平台子库，补入未登记的 ROM"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="ScanPlatformLibrary_Click" />
                                        <Button x:Name="OrganizePlatformButton" Content="整理库文件…" Margin="0,0,8,8"
                                                ToolTip="按「标题 (区域)(语言)」重命名该平台子库内的文件"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="OrganizePlatform_Click" />
                                        <Button x:Name="CancelScanButton" Content="取消扫描" Margin="0,0,8,8"
                                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                                Click="CancelScan_Click" />
                                    </WrapPanel>

                                    <ProgressBar x:Name="PlatformScanProgress" Height="4" Margin="0,12,0,0"
                                                 Maximum="100" Value="0" Visibility="Collapsed" />
                                    <TextBlock x:Name="PlatformScanHint" Style="{StaticResource SettingsHintStyle}"
                                               MaxWidth="560"
                                               Text="扫描会补入未登记的 ROM，并清理该平台中文件已不存在的条目；整理会按「标题 (区域)(语言)」重命名子库内的文件（多碟自动带 Disc 号）。" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 设备 -->
            <TabItem x:Name="DeviceTab" Header="设备">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="28,20,28,0">
                        <TextBlock Text="设备" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="发送到掌机时的目录规则与平台映射；内置 TrimUI Smart Pro，可按盘符新增配置。" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0"
                            Margin="28,16,28,22">
                        <ContentControl x:Name="DeviceTabHost" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- AI · 连接 -->
            <TabItem Header="连接" Tag="AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="连接" Style="{StaticResource SettingsPageTitleStyle}" />
                                <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                           Text="OpenAI 兼容接口；API Key 只存本机数据库，落盘前用 Windows DPAPI 按当前用户加密。" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="保存 AI 设置" Width="130" VerticalAlignment="Top"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveAi_Click" />
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" MaxWidth="620" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="预设" Style="{StaticResource SettingsRowLabelStyle}" />
                                <ComboBox x:Name="AiPresetCombo" Grid.Row="0" Grid.Column="1" Width="260"
                                          HorizontalAlignment="Left" MinHeight="32" Margin="0,0,0,16"
                                          SelectionChanged="AiPreset_Changed">
                                    <ComboBoxItem Content="自定义" />
                                    <ComboBoxItem Content="DeepSeek" />
                                    <ComboBoxItem Content="Kimi" />
                                    <ComboBoxItem Content="OpenAI" />
                                </ComboBox>
                                <Rectangle Grid.Row="0" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="1" Text="BaseUrl" Style="{StaticResource SettingsRowLabelStyle}" />
                                <TextBox x:Name="AiBaseUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,16"
                                         ToolTip="OpenAI 兼容端点，例如 https://api.deepseek.com/v1" />
                                <Rectangle Grid.Row="1" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="2" Text="API Key" Style="{StaticResource SettingsRowLabelStyle}" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <PasswordBox x:Name="AiApiKeyBox" MinHeight="32" VerticalContentAlignment="Center"
                                                     Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        <TextBox x:Name="AiApiKeyPlainBox" Visibility="Collapsed" />
                                    </Grid>
                                    <CheckBox x:Name="AiShowKeyCheck" Grid.Column="1" Content="显示" Margin="14,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="AiShowKey_Changed" Unchecked="AiShowKey_Changed" />
                                </Grid>
                                <Rectangle Grid.Row="2" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="3" Text="模型名" Style="{StaticResource SettingsRowLabelStyle}" />
                                <TextBox x:Name="AiModelBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,16"
                                         ToolTip="例如 deepseek-chat、gpt-4o-mini" />
                                <Rectangle Grid.Row="3" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="4" Text="超时" Style="{StaticResource SettingsRowLabelStyle}" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBox x:Name="AiTimeoutBox" Width="90" ToolTip="10–600 秒" />
                                    <TextBlock Text="秒" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="10–600" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource SettingsHintStyle}" />
                                </StackPanel>
                                <Rectangle Grid.Row="4" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="5" Text="批量上限" Style="{StaticResource SettingsRowLabelStyle}" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="AiBatchLimitBox" Width="90" ToolTip="1–200 条；超过时请分批处理" />
                                    <TextBlock Text="条" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="单次刮削 / 修改的最大条数，1–200" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Style="{StaticResource SettingsHintStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                            <Button x:Name="AiTestButton" Content="测试连接"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="TestAi_Click" />
                            <Button x:Name="AiSearchTestButton" Content="测试搜索" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="TestSearch_Click" />
                            <TextBlock x:Name="AiTestText" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,14,0,0"
                                   Text="AI 只接收游戏标题、文件名、平台等文本信息，不上传 ROM、封面或存档。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AI · 联网搜索 -->
            <TabItem Header="联网搜索" Tag="AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="联网搜索" Style="{StaticResource SettingsPageTitleStyle}" />
                                <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                           Text="使用 DeepSeek 官方 Search API，复用「连接」页的 API Key 与 https://api.deepseek.com/v1 端点；其他 BaseUrl 暂不支持，按成功请求计费。" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="保存 AI 设置" Width="130" VerticalAlignment="Top"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="SaveAi_Click" />
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" MaxWidth="620" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="开关" Style="{StaticResource SettingsRowLabelStyle}" />
                                <CheckBox x:Name="AiSearchEnabledCheck" Grid.Row="0" Grid.Column="1" Margin="0,6,0,16"
                                          Content="允许 AI 联网搜索（刮削 / 助手）"
                                          ToolTip="使用 DeepSeek 官方 Search API，复用「连接」页的 API Key" />
                                <Rectangle Grid.Row="0" Style="{StaticResource SettingsRowLineStyle}" />

                                <TextBlock Grid.Row="1" Text="结果条数" Style="{StaticResource SettingsRowLabelStyle}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="AiSearchMaxBox" Width="90" ToolTip="1–10 条；条数不影响单次计费" />
                                    <TextBlock Text="1–10 条；条数不影响单次计费" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Style="{StaticResource SettingsHintStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,14,0,0"
                                   Text="「测试搜索」在「连接」页，和「测试连接」放在一起。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 提示词 -->
            <TabItem Header="提示词" Tag="提示词">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="28,20,28,0">
                        <TextBlock Text="提示词" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="整段改写 AI 的系统提示词与用户模板，用 {{变量}} 占位；保存后下次调用生效。" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0"
                            Margin="28,16,28,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="10,14,10,14">
                                <TextBlock DockPanel.Dock="Top" Text="场景" Margin="10,0,0,10"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ListBox x:Name="PromptList" SelectionChanged="PromptList_SelectionChanged" />
                            </DockPanel>

                            <Border Grid.Column="1" Width="1" Margin="0,14"
                                    Background="{DynamicResource HairlineBrush}" />

                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="20,14,20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="PromptUserLabelRow" Height="Auto" />
                                    <RowDefinition x:Name="PromptUserBoxRow" Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="PromptTitleText" Style="{StaticResource SettingsGroupTitleStyle}"
                                               FontSize="16" Text="选择左侧提示词" />
                                    <TextBlock x:Name="PromptDescText" Style="{StaticResource SettingsGroupDescStyle}" />
                                    <TextBlock x:Name="PromptVarsText" Style="{StaticResource SettingsHintStyle}"
                                               FontSize="11" />
                                </StackPanel>

                                <DockPanel Grid.Row="1" Margin="0,0,0,14">
                                    <TextBlock DockPanel.Dock="Top" Text="系统提示词"
                                               Style="{StaticResource SettingsRowLabelStyle}" Margin="0,0,0,6" />
                                    <TextBox x:Name="PromptSystemBox" Height="250" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                             Padding="8" />
                                </DockPanel>

                                <TextBlock x:Name="PromptUserLabel" Grid.Row="2" Text="用户模板"
                                           Style="{StaticResource SettingsRowLabelStyle}" Margin="0,0,0,6" />
                                <TextBox x:Name="PromptUserBox" Grid.Row="3" Height="140" AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                         Padding="8" Margin="0,0,0,14" />

                                <DockPanel Grid.Row="4" Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                        <Button Content="恢复当前默认" Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PromptReset_Click" />
                                        <Button Content="全部恢复默认" Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="8,0,0,0" Click="PromptResetAll_Click" />
                                        <Button Content="保存提示词" Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="8,0,0,0" Click="PromptSave_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="PromptStatusText" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                </DockPanel>
                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 数据维护 · 备份与导出 -->
            <TabItem Header="备份与导出" Tag="数据维护">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,16">
                        <TextBlock Text="备份与导出" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="备份是复制当前 mica.db；恢复会用备份覆盖当前库，重启后生效（恢复前自动再备份一次）。" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <WrapPanel>
                                <Button Content="打开数据目录" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="OpenDataDir_Click" />
                                <Button Content="备份数据库…" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Backup_Click" />
                                <Button Content="从备份恢复…" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Restore_Click" />
                                <Button Content="导出 CSV…" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="ExportCsv_Click" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 数据维护 · 修复与清理 -->
            <TabItem Header="修复与清理" Tag="数据维护">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,16">
                        <TextBlock Text="修复与清理" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="清理只删数据库记录、不动文件；所在盘未连接时会中止，避免误删进度与元数据。" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="清理失效路径记录" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="CleanMissing_Click" />
                                    <Button Content="补算缺失指纹" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="HashMissing_Click" />
                                    <Button x:Name="CancelHashButton" Content="取消补算" IsEnabled="False" Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}" Click="CancelHash_Click" />
                                </WrapPanel>
                                <ProgressBar x:Name="MaintenanceProgress" Height="4" Margin="0,14,0,0"
                                             Maximum="100" Value="0" Visibility="Collapsed" />
                                <TextBlock x:Name="MaintenanceStatus" Style="{StaticResource SettingsHintStyle}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 关于 -->
            <TabItem Header="关于" Tag="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,22,28,26">
                        <TextBlock Text="关于" Style="{StaticResource SettingsPageTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsPageDescStyle}"
                                   Text="Windows 桌面端的 ROM 集中管理工具：导入、编辑、模拟器启动、推荐、发送与分享打包。" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="Mica ROM Manager" Style="{StaticResource SettingsGroupTitleStyle}" FontSize="16" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource SettingsGroupDescStyle}" />
                                <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,14,0,0"
                                           Text="WPF / .NET 9 / SQLite，绿色便携，不写注册表。数据保存在程序目录的 data\ 下，整个文件夹拷走即可换机器。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="几条规矩" Style="{StaticResource SettingsGroupTitleStyle}" />
                                <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,10,0,0"
                                           Text="· ROM 删除一律走回收站，不做彻底删除。" />
                                <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,0"
                                           Text="· 「从库中移除」只删记录，不动文件。" />
                                <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,4,0,0"
                                           Text="· 所在盘未连接时，不执行任何会丢元数据的清理。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
