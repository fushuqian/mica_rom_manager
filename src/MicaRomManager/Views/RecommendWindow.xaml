<Window x:Class="MicaRomManager.Views.RecommendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="推荐游戏"
        Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="猜你喜欢" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Header}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="本地打分：同平台、同开发商、同类型、同标签、未玩过优先。双击可定位到主列表。" />
        </StackPanel>

        <DataGrid x:Name="RecommendGrid" Grid.Row="1" Style="{StaticResource AppDataGridStyle}"
                  ItemsSource="{Binding Items}" MouseDoubleClick="RowDoubleClick"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="游戏" Binding="{Binding Game.Title}" Width="240" />
                <DataGridTextColumn Header="平台" Binding="{Binding Game.Platform}" Width="110" />
                <DataGridTextColumn Header="状态" Binding="{Binding Game.Status}" Width="80" />
                <DataGridTextColumn Header="评分" Binding="{Binding Game.RatingStars}" Width="90" />
                <DataGridTextColumn Header="理由" Binding="{Binding Reason}" Width="*" />
                <DataGridTextColumn Header="分数" Binding="{Binding Score, StringFormat={}{0:0.0}}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
