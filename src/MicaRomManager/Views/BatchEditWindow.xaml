<Window x:Class="MicaRomManager.Views.BatchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaRomManager.Controls"
        Title="批量编辑"
        Width="640" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Title}" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="只修改勾选的字段，未勾选的保持原值。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Content="平台" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyPlatform}" />
                <ComboBox Grid.Row="0" Grid.Column="1" MinHeight="28" Margin="0,0,0,10" IsEditable="True"
                          IsEnabled="{Binding ApplyPlatform}"
                          ItemsSource="{Binding Platforms}"
                          Text="{Binding PlatformValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="1" Content="类型" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyGenre}" />
                <TextBox Grid.Row="1" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                         IsEnabled="{Binding ApplyGenre}"
                         Text="{Binding GenreValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="2" Content="区域" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyRegion}" />
                <ComboBox Grid.Row="2" Grid.Column="1" MinHeight="28" Margin="0,0,0,10" IsEditable="True"
                          IsEnabled="{Binding ApplyRegion}"
                          ItemsSource="{Binding Regions}"
                          Text="{Binding RegionValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="3" Content="语言" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyLanguage}" />
                <ComboBox Grid.Row="3" Grid.Column="1" MinHeight="28" Margin="0,0,0,10" IsEditable="True"
                          IsEnabled="{Binding ApplyLanguage}"
                          ItemsSource="{Binding Languages}"
                          Text="{Binding LanguageValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="4" Content="年份" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyReleaseYear}" />
                <TextBox Grid.Row="4" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                         IsEnabled="{Binding ApplyReleaseYear}"
                         ToolTip="1950–2100 的整数；留空表示清空年份"
                         Text="{Binding ReleaseYearText, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="5" Content="发行商" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyPublisher}" />
                <TextBox Grid.Row="5" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                         IsEnabled="{Binding ApplyPublisher}"
                         Text="{Binding PublisherValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="6" Content="开发商" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyDeveloper}" />
                <TextBox Grid.Row="6" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                         IsEnabled="{Binding ApplyDeveloper}"
                         Text="{Binding DeveloperValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="7" Content="状态" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyStatus}" />
                <ComboBox Grid.Row="7" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                          IsEnabled="{Binding ApplyStatus}"
                          ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding StatusValue, Mode=TwoWay}" />

                <CheckBox Grid.Row="8" Content="模拟器" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyEmulator}" />
                <ComboBox Grid.Row="8" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                          IsEnabled="{Binding ApplyEmulator}"
                          ItemsSource="{Binding EmulatorChoices}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedEmulator, Mode=TwoWay}" />

                <CheckBox Grid.Row="9" Content="追加标签" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyTagsAdd}" />
                <TextBox Grid.Row="9" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                         IsEnabled="{Binding ApplyTagsAdd}"
                         ToolTip="多个标签用逗号分隔；已有同名标签不会重复添加"
                         Text="{Binding TagsAddValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="10" Content="移除标签" VerticalAlignment="Center"
                          IsChecked="{Binding ApplyTagsRemove}" />
                <TextBox Grid.Row="10" Grid.Column="1" MinHeight="28" Margin="0,0,0,10"
                         IsEnabled="{Binding ApplyTagsRemove}"
                         ToolTip="多个标签用逗号分隔"
                         Text="{Binding TagsRemoveValue, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="11" Content="备注" VerticalAlignment="Top" Margin="0,6,0,0"
                          IsChecked="{Binding ApplyNotes}" />
                <StackPanel Grid.Row="11" Grid.Column="1" IsEnabled="{Binding ApplyNotes}">
                    <ComboBox MinHeight="28" Margin="0,0,0,8" SelectedIndex="{Binding NotesModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="追加到原备注末尾" />
                        <ComboBoxItem Content="覆盖原备注" />
                    </ComboBox>
                    <TextBox Height="70" Margin="0,0,0,10" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Text="{Binding NotesValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" MaxWidth="360"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
            <Button Content="应用" Width="88" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
