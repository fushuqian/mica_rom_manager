<Window x:Class="MicaRomManager.Views.ExePickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择可执行文件"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}"
                   Text="在安装目录中找到多个 exe，请选择启动用的可执行文件：" />

        <ListBox x:Name="ExeList" Grid.Row="1" ItemsSource="{Binding Options}"
                 DisplayMemberPath="Display" BorderBrush="{StaticResource BorderBrush}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="88" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" IsDefault="True" />
            <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
