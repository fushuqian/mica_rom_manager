<Window x:Class="MicaRomManager.Views.ConnectDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接到设备"
        Width="660" Height="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}"
                   Text="选择设备类型与目标路径" />
        <TextBlock Grid.Row="1" Margin="0,4,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="连接后本次运行期间保持有效；之后在主界面多选游戏，点「发送」或右键「发送到设备」即可直接入队。" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="设备类型" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" MinHeight="28"
                      ItemsSource="{Binding Profiles}" DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="目标路径" Style="{StaticResource FieldLabelStyle}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Width="360" MinHeight="28" ItemsSource="{Binding Drives}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" />
                <Button Content="刷新" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshDrivesCommand}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="目标位置" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TargetPreview}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <CheckBox Content="同名文件覆盖（默认跳过已存在的文件）"
                      IsChecked="{Binding OverwriteSameName}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="发送只复制 ROM 文件，不动原库；多碟游戏的全部碟片一起发送。目录规则由「设置 → 设备」里的配置决定。" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                       Text="{Binding StatusText}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="连接" Width="96" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ConnectCommand}" IsDefault="True" />
            <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
