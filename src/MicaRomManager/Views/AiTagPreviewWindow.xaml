<Window x:Class="MicaRomManager.Views.AiTagPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 标签"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="AI 标签与类型" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AiHint}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Width="150" SelectedIndex="{Binding AppendMode, Converter={StaticResource BoolToIndexConverter}}">
                <ComboBoxItem Content="追加到现有标签" />
                <ComboBoxItem Content="替换现有标签" />
            </ComboBox>
            <Button Grid.Column="1" Content="重新生成" Margin="8,0,0,0" Command="{Binding StartCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ProgressText}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <DataGrid Grid.Row="2" Style="{StaticResource AppDataGridStyle}" IsReadOnly="False" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="应用" Binding="{Binding Apply, Mode=TwoWay}" Width="46" />
                <DataGridTextColumn Header="游戏" Binding="{Binding Title}" Width="220" IsReadOnly="True" />
                <DataGridTextColumn Header="现有标签" Binding="{Binding CurrentTags}" Width="160" IsReadOnly="True" />
                <DataGridTextColumn Header="建议标签" Binding="{Binding TagsText}" Width="220" IsReadOnly="True" />
                <DataGridTextColumn Header="建议类型" Binding="{Binding Genre}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,12,220" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="应用" Width="88" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Apply_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
