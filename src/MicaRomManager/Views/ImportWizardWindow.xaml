<Window x:Class="MicaRomManager.Views.ImportWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入向导"
        Width="820" Height="660"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="1. 添加要导入的 ROM 文件或文件夹" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SourceList" Grid.Column="0" Height="86" Margin="0,0,8,0"
                     SelectionMode="Extended" ItemsSource="{Binding Sources}" />

            <StackPanel Grid.Column="1" Orientation="Vertical">
                <Button Content="添加文件…" Width="104" Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click" />
                <Button Content="添加文件夹…" Width="104" Margin="0,6,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFolder_Click" />
                <Button Content="移除选中" Width="104" Margin="0,6,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Click="RemoveSelected_Click" />
                <Button Content="清空" Width="104" Margin="0,6,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ClearSources_Click" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding Summary}" />

        <DataGrid x:Name="CandidateGrid" Grid.Row="3" Style="{StaticResource AppDataGridStyle}"
                  ItemsSource="{Binding Candidates}" IsReadOnly="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="250" IsReadOnly="True"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="220"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTemplateColumn Header="平台" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" MinHeight="22" VerticalAlignment="Center"
                                      ItemsSource="{Binding DataContext.Platforms, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="90" IsReadOnly="True"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="批量指定平台：" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox x:Name="BulkPlatformCombo" Width="160" MinHeight="28" Margin="0,0,8,0"
                      IsEditable="True" ItemsSource="{Binding Platforms}" />
            <Button Content="应用到全部" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyToAll_Click" />
        </StackPanel>

        <TextBlock Grid.Row="5" Style="{StaticResource SectionTitleStyle}" Text="2. 选择入库方式" />

        <StackPanel Grid.Row="6" Margin="0,4,0,0">
            <RadioButton x:Name="LinkRadio" Content="仅链接：只记录路径，不移动也不复制文件" Margin="0,0,0,6" />
            <RadioButton x:Name="CopyRadio" Content="复制到库目录（原文件保留）" Margin="0,0,0,6" />
            <RadioButton x:Name="MoveRadio" Content="移动到库目录（原位置文件会被移走）" Margin="0,0,0,6" />
            <TextBlock Margin="20,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding LibraryHint}" />
            <CheckBox x:Name="RecursiveCheck" Content="包含子文件夹中的 ROM" IsChecked="True" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="BusyText" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="ConfirmButton" Content="开始导入" Width="104"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsDefault="True" />
            <Button Content="取消" Width="88" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
