<Window x:Class="MicaRomManager.Views.EmulatorTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增模拟器"
        Width="660" Height="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="选择模拟器模板" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="模板会预填名称、启动参数、GitHub 仓库与备注；模板来自 data\EmulatorTemplates.json，首次运行会从 Resources 复制。" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Height="28" Padding="8,0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="按模拟器名称、平台或备注筛选" />
                    <TextBlock Text="搜索名称、平台或备注…" Margin="9,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="TemplateCountText" Grid.Column="1" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </StackPanel>

        <ListBox x:Name="TemplateList" Grid.Row="1" Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PlatformsText}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Notes}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="创建" Width="88" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Create_Click" />
                <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,12,0"
                       Text="没有合适模板时选「空白模拟器」，创建后可在「编辑配置」里改。" />
        </DockPanel>
    </Grid>
</Window>
