<Window x:Class="MicaRomManager.Views.GameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏信息"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}">
            <Run Text="游戏信息" />
            <Run Text="（双击列表行可再次编辑）" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" FontSize="12" />
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="标题" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,8,10"
                         Text="{Binding Model.Title, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="0" Grid.Column="3" Content="收藏" IsChecked="{Binding Model.Favorite}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="平台" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" IsEditable="True" MinHeight="28"
                          ItemsSource="{Binding Platforms}"
                          Text="{Binding Model.Platform, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="类型" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10"
                         Text="{Binding Model.Genre, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="地区" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,10"
                         Text="{Binding Model.Region, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="年份" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,10"
                         Text="{Binding Model.ReleaseYear, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="发行商" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,8,10"
                         Text="{Binding Model.Publisher, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="开发商" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="3" Margin="0,0,0,10"
                         Text="{Binding Model.Developer, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="状态" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,8,10" MinHeight="28"
                          ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding Model.Status, Mode=TwoWay}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="模拟器" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox Grid.Row="4" Grid.Column="3" Margin="0,0,0,10" MinHeight="28"
                          ItemsSource="{Binding Emulators}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedEmulator, Mode=TwoWay}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="ROM 路径" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,8,10" IsReadOnly="True"
                         Text="{Binding Model.RomPath}" />
                <Button Grid.Row="5" Grid.Column="3" Content="浏览…" Margin="0,0,0,10"
                        Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseRomCommand}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="文件大小" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,8,10" IsReadOnly="True"
                         Text="{Binding Model.FileSizeDisplay, Mode=OneWay}" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="标签" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="6" Grid.Column="3" Margin="0,0,0,10"
                         Text="{Binding Model.Tags, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="多个标签用逗号分隔" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="封面" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,4,8,0" />
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,10">
                    <Button Content="选择封面…" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BrowseCoverCommand}" />
                    <Button Content="清除" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearCoverCommand}" />
                </StackPanel>
                <Border Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2" Height="96" Margin="0,0,0,10"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" HorizontalAlignment="Left" Width="96">
                    <Image Stretch="UniformToFill"
                           Source="{Binding Model.CoverPath, Converter={StaticResource CoverThumbnailConverter}}" />
                </Border>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="备注" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,4,8,0" />
                <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Height="80" Margin="0,0,0,10"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Text="{Binding Model.Notes, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Error}"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="保存" Width="88" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" IsDefault="True" />
            <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
