<Window x:Class="MicaRomManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MicaRomManager.Views"
        Title="设置"
        Width="980" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <TabItem Header="常规">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="数据目录" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="DataDirText" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,12" />
                    <Button Grid.Row="0" Grid.Column="2" Content="打开" Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenDataDir_Click" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="导入策略" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ImportModeCombo" Grid.Row="1" Grid.Column="1" Width="280"
                              HorizontalAlignment="Left" MinHeight="28" Margin="0,0,0,12">
                        <ComboBoxItem Content="仅链接（只记录路径，不移动、不复制）" />
                        <ComboBoxItem Content="复制到库目录后入库" />
                        <ComboBoxItem Content="移动到库目录后入库" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="库目录" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="LibraryRootBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,12" />
                    <Button Grid.Row="2" Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseLibraryRoot_Click" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <CheckBox x:Name="PortableModeCheck"
                                  Content="便携模式（库目录为程序目录下的相对路径）" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="520"
                                   Text="程序 exe 与库文件夹放在同一盘，库目录为程序目录下的任意命名文件夹（如 E:\MicaRomManager.exe + E:\game_library\）。开启后库目录、ROM / 碟片 / 封面、模拟器路径都存为相对路径，换电脑盘符变化仍可用。" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="网络代理" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ProxyModeCombo" Grid.Row="4" Grid.Column="1" Width="280"
                              HorizontalAlignment="Left" MinHeight="28" Margin="0,0,0,12"
                              SelectionChanged="ProxyMode_Changed">
                        <ComboBoxItem Content="不使用代理" />
                        <ComboBoxItem Content="跟随系统代理" />
                        <ComboBoxItem Content="手动代理" />
                    </ComboBox>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="代理地址" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ProxyAddressBox" Grid.Row="5" Grid.Column="1" Margin="0,0,8,12"
                             ToolTip="格式：host:port，例如 127.0.0.1:7890（仅手动代理时生效）" />
                    <Button Grid.Row="5" Grid.Column="2" Content="测试 GitHub 连接"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="TestNetwork_Click" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="保存常规设置" Width="130"
                                Style="{StaticResource PrimaryButtonStyle}" Click="SaveGeneral_Click" />
                        <TextBlock x:Name="NetworkTestText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="提示：数据目录内含 mica.db、covers、emulators、downloads、exports、logs。程序优先使用便携目录，不可写时才回退到 LocalAppData。代理设置同时作用于 GitHub 检查更新与安装包下载。" />
                </Grid>
            </TabItem>

            <TabItem Header="模拟器管理">
                <views:EmulatorManagerView />
            </TabItem>

            <TabItem Header="字典库">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionTitleStyle}" Text="字段" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionTitleStyle}" Text="值" />

                    <ListBox x:Name="LookupKindList" Grid.Row="1" Grid.Column="0"
                             SelectionChanged="LookupKindList_SelectionChanged" />
                    <ListBox x:Name="LookupValueList" Grid.Row="1" Grid.Column="2" />

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                        <TextBox x:Name="NewLookupValueBox" ToolTip="输入新的值" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="添加" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="AddLookupValue_Click" />
                            <Button Content="重命名选中" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RenameLookupValue_Click" />
                            <Button Content="删除选中" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RemoveLookupValue_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="改名会同步更新已有游戏记录；仍有记录使用的值不能删除。平台名称也只在这里维护。" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="平台">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="PlatformList" Grid.Row="0" Grid.Column="0"
                             SelectionChanged="PlatformList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="（自定义）" Margin="4,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="平台名称请在「字典库 → 平台」里维护；这里只配置该平台的模拟器、目录、格式、核心与启动参数。" />

                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
                        <TextBlock x:Name="PlatformNameText" Style="{StaticResource SectionTitleStyle}"
                                   Text="（未选择平台）" />
                        <TextBlock Text="默认模拟器" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4" />
                        <ComboBox x:Name="PlatformEmulatorCombo" MinHeight="28" Width="260"
                                  HorizontalAlignment="Left" SelectionChanged="PlatformEmulator_Changed" />

                        <StackPanel x:Name="PlatformCorePanel" Visibility="Collapsed">
                            <TextBlock Text="RetroArch 核心" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                            <ComboBox x:Name="PlatformCoreCombo" MinHeight="28" Width="320"
                                      HorizontalAlignment="Left" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="380"
                                       Text="从模拟器安装目录的 cores 文件夹读取；不选则使用模拟器自带核心。" />
                        </StackPanel>

                        <TextBlock Text="库内子文件夹" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <TextBox x:Name="PlatformFolderBox" Width="260" HorizontalAlignment="Left"
                                 ToolTip="复制 / 移动入库时使用的子文件夹名，留空则用平台名" />
                        <TextBlock Text="支持的 ROM 格式" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <TextBox x:Name="PlatformFormatsBox" Width="320" HorizontalAlignment="Left"
                                 ToolTip="空格或逗号分隔，如 iso cue bin chd pbp；留空表示不限制" />
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="380"
                                   Text="扫描该平台子库时只识别这些扩展名；导入时用于自动识别平台。留空表示不限制。" />
                        <TextBlock Text="额外启动参数" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <TextBox x:Name="PlatformArgsBox" Width="420" HorizontalAlignment="Left"
                                 ToolTip="可选，会追加在模拟器默认参数之后；占位符：{rom} {romdir} {romname} {core}；留空则只用模拟器默认参数" />
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="420"
                                   Text="这里只填额外参数（如 --fullscreen），程序会拼在模拟器默认参数后面；留空则完全使用模拟器默认参数。{config} 已不再使用。" />
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="360"
                                   Text="说明：启动游戏时会使用这里配置的默认模拟器、核心与启动参数。" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存平台设置" Width="120"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="SavePlatform_Click" />
                            <Button x:Name="ScanPlatformButton" Content="扫描该平台库目录…" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ScanPlatformLibrary_Click" />
                            <Button x:Name="OrganizePlatformButton" Content="整理该平台库文件…" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OrganizePlatform_Click" />
                        </StackPanel>
                        <TextBlock x:Name="PlatformScanHint" Margin="0,6,0,0" MaxWidth="380" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="扫描会补入未登记的 ROM，并清理该平台中文件已不存在的条目；整理会按「标题 (区域)(语言)」重命名子库内的文件（多碟自动带 Disc 号）。" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="设备">
                <views:DeviceSettingsView />
            </TabItem>

            <TabItem Header="AI">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="预设" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="AiPresetCombo" Grid.Row="0" Grid.Column="1" Width="280" MinHeight="28"
                              HorizontalAlignment="Left" Margin="0,0,0,12"
                              SelectionChanged="AiPreset_Changed">
                        <ComboBoxItem Content="自定义" />
                        <ComboBoxItem Content="DeepSeek" />
                        <ComboBoxItem Content="Kimi" />
                        <ComboBoxItem Content="OpenAI" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BaseUrl" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="AiBaseUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                             ToolTip="OpenAI 兼容端点，例如 https://api.deepseek.com/v1" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <PasswordBox x:Name="AiApiKeyBox" MinHeight="28" VerticalContentAlignment="Center"
                                     Padding="6,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                        <TextBox x:Name="AiApiKeyPlainBox" Visibility="Collapsed" />
                    </Grid>
                    <CheckBox x:Name="AiShowKeyCheck" Grid.Row="2" Grid.Column="2" Content="显示" Margin="8,0,0,12"
                              VerticalAlignment="Center" Checked="AiShowKey_Changed" Unchecked="AiShowKey_Changed" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="模型名" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="AiModelBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"
                             ToolTip="例如 deepseek-chat、gpt-4o-mini" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="超时（秒）" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="AiTimeoutBox" Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                             Margin="0,0,0,12" ToolTip="10–600 秒" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="单次批量上限" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="AiBatchLimitBox" Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                             Margin="0,0,0,12" ToolTip="1–200 条；超过时请分批处理" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="联网搜索" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,12">
                        <CheckBox x:Name="AiSearchEnabledCheck" Content="允许 AI 联网搜索（刮削 / 助手）"
                                  ToolTip="使用 DeepSeek 官方 Search API，复用上面的 API Key" />
                    </StackPanel>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="搜索结果条数" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="AiSearchMaxBox" Grid.Row="7" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                             Margin="0,0,0,12" ToolTip="1–10 条；条数不影响单次计费" />

                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="保存 AI 设置" Width="130" Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveAi_Click" />
                        <Button x:Name="AiTestButton" Content="测试连接" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="TestAi_Click" />
                        <Button x:Name="AiSearchTestButton" Content="测试搜索" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="TestSearch_Click" />
                        <TextBlock x:Name="AiTestText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="说明：API Key 只保存在本机数据库；AI 只接收游戏标题、文件名、平台等文本信息，不上传 ROM、封面或存档。未配置时相关按钮会置灰或只做本地解析。" />
                    <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="联网搜索：使用 DeepSeek 官方 Search API，复用同一个 API Key 和 https://api.deepseek.com/v1 端点；其他 BaseUrl 暂不支持。按成功请求计费（官方定价约 $0.75 / 1000 次，以账单为准）。" />
                </Grid>
            </TabItem>

            <TabItem Header="提示词">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="PromptList" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                             SelectionChanged="PromptList_SelectionChanged" />

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock x:Name="PromptTitleText" Style="{StaticResource SectionTitleStyle}"
                                   Text="选择左侧提示词" />
                        <TextBlock x:Name="PromptDescText" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="PromptVarsText" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="PromptUserLabelRow" Height="Auto" />
                            <RowDefinition x:Name="PromptUserBoxRow" Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="系统提示词" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="PromptSystemBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 FontFamily="Consolas" FontSize="12" Padding="6" Margin="0,0,0,10" />

                        <TextBlock x:Name="PromptUserLabel" Grid.Row="2" Text="用户模板" FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="PromptUserBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 FontFamily="Consolas" FontSize="12" Padding="6" Margin="0,0,0,10" />

                        <DockPanel Grid.Row="4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="恢复当前默认" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="PromptReset_Click" />
                                <Button Content="全部恢复默认" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Click="PromptResetAll_Click" />
                                <Button Content="保存提示词" Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="8,0,0,0" Click="PromptSave_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PromptStatusText" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="数据维护">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="数据库与数据" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="备份会复制当前数据库文件；恢复会用备份覆盖当前数据库，需要重启程序生效。" />
                    <WrapPanel>
                        <Button Content="备份数据库…" Style="{StaticResource SecondaryButtonStyle}" Click="Backup_Click" />
                        <Button Content="从备份恢复…" Style="{StaticResource SecondaryButtonStyle}" Click="Restore_Click" />
                        <Button Content="导出 CSV…" Style="{StaticResource SecondaryButtonStyle}" Click="ExportCsv_Click" />
                        <Button Content="清理失效路径记录" Style="{StaticResource SecondaryButtonStyle}" Click="CleanMissing_Click" />
                        <Button Content="补算缺失指纹" Style="{StaticResource SecondaryButtonStyle}" Click="HashMissing_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="MaintenanceStatus" Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="关于">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Mica ROM Manager" />
                    <TextBlock x:Name="VersionText" Margin="0,0,0,8" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="Windows 桌面端 ROM 集中管理工具。支持导入、编辑、模拟器启动、分享打包（ROM + 模拟器 + 一键启动脚本）。" />
                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="规则：ROM 删除一律走回收站；「从库中移除」不会删除文件。" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
