<Window x:Class="MicaRomManager.Views.AiRenamePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 标题翻译"
        Width="980" Height="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="标题翻译与文件整理" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AiHint}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Width="190" SelectedIndex="{Binding RenameFiles, Converter={StaticResource BoolToIndexConverter}}">
                <ComboBoxItem Content="只改标题（不动文件）" />
                <ComboBoxItem Content="改标题并整理库内文件" />
            </ComboBox>
            <Button Grid.Column="1" Content="开始翻译" Margin="8,0,0,0" Command="{Binding StartCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ProgressText}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <DataGrid Grid.Row="2" Style="{StaticResource AppDataGridStyle}" IsReadOnly="False" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="应用" Binding="{Binding Apply, Mode=TwoWay}" Width="46" />
                <DataGridTextColumn Header="原标题" Binding="{Binding OldTitle}" Width="200" IsReadOnly="True" />
                <DataGridTextColumn Header="新标题" Binding="{Binding NewTitle}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="原文件名" Binding="{Binding OldFileName}" Width="230" IsReadOnly="True" />
                <DataGridTextColumn Header="新文件名" Binding="{Binding NewFileName}" Width="230" IsReadOnly="True" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="140" IsReadOnly="True" />
                <DataGridTextColumn Header="备注/错误" Binding="{Binding Error}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,12,240" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="应用" Width="88" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Apply_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
