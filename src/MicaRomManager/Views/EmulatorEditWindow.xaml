<Window x:Class="MicaRomManager.Views.EmulatorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模拟器配置"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="模拟器配置" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                         Text="{Binding Model.Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="安装目录" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" Text="{Binding Model.InstallDir}" />
                <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseInstallDirCommand}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="可执行文件" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,10"
                         Text="{Binding Model.ExePath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="相对安装目录或绝对路径，例如 retroarch.exe" />
                <Button Grid.Row="2" Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseExeCommand}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="版本" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                         Text="{Binding Model.Version, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="官网地址" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                         Text="{Binding Model.WebsiteUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="例如 https://www.retroarch.com 或 GitHub Releases 页面" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="GitHub 仓库" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                         Text="{Binding Model.GithubRepo, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="owner/repo，例如 libretro/RetroArch；填了才能在模拟器管理里一键检查更新" />
                <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="填了 GitHub 仓库（owner/repo）后可一键检查更新、下载并安装；官网地址作为手动下载的兜底。" />

                <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                           Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <CheckBox Content="启用该模拟器" IsChecked="{Binding Model.Enabled}" Margin="0,8,0,0" />
            <TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4" />
            <TextBox Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     Text="{Binding Model.Notes, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="保存" Width="88" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" IsDefault="True" />
                <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
