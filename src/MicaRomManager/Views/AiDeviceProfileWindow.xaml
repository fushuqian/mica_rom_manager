<Window x:Class="MicaRomManager.Views.AiDeviceProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 识别设备结构"
        Width="920" Height="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="AI 设备配置建议" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Header}" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding ConfidenceText}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Foreground="{StaticResource DangerBrush}" Text="{Binding Error}" TextWrapping="Wrap" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding WarningsText}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="名称" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />
                    <TextBlock Grid.Row="1" Text="品牌 / 型号" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BrandModel}" />
                    <TextBlock Grid.Row="2" Text="盘内根目录" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RootFolder}" />
                    <TextBlock Grid.Row="3" Text="目录模板" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FolderTemplate}" />
                    <TextBlock Grid.Row="4" Text="平台映射" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PlatformFoldersText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Text="备注" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Notes}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Nodes}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="目录" Binding="{Binding RelPath}" Width="*" />
                <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="80" />
                <DataGridTextColumn Header="扩展名统计" Binding="{Binding TopExtensions}" Width="280" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
            <Button Content="填充到表单" Width="110" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
