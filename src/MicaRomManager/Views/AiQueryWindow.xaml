<Window x:Class="MicaRomManager.Views.AiQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 查询"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="用自然语言查库" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="模型只把请求转换成受控筛选条件或白名单操作，不会生成 SQL，也不会删除或启动游戏。" />
        </StackPanel>

        <TextBox Grid.Row="1" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="例如：找出所有未通关的 PS1 游戏" />

        <WrapPanel Grid.Row="2" Margin="0,8,0,10">
            <TextBlock Text="示例：" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <Button Content="找出所有未通关的 PS1 游戏" Style="{StaticResource ToolButtonStyle}"
                    Tag="找出所有未通关的 PS1 游戏" Click="Example_Click" FontSize="12" />
            <Button Content="把 SNES 里没玩过的加标签 待补" Style="{StaticResource ToolButtonStyle}"
                    Tag="把 SNES 里没玩过的加标签 待补" Click="Example_Click" FontSize="12" />
            <Button Content="显示今年收藏的 RPG" Style="{StaticResource ToolButtonStyle}"
                    Tag="显示今年收藏的 RPG" Click="Example_Click" FontSize="12" />
        </WrapPanel>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}">
                    <Run Text="预计命中：" />
                    <Run Text="{Binding HitCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" 条" />
                </TextBlock>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="解析" Width="88" Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Click="Parse_Click" />
            <Button Content="{Binding ApplyText}" Width="100" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click" />
            <Button Content="取消" Width="88" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
