<Window x:Class="MicaRomManager.Views.ScrapePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 刮削"
        Width="1120" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="刮削信息" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AiHint}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" Content="使用 AI 补全" IsChecked="{Binding UseAi}"
                      IsEnabled="{Binding AiConfigured}" ToolTip="只发送文件名、平台与现有标题，不上传 ROM" />
            <ComboBox Grid.Column="1" Width="150" SelectedIndex="{Binding Overwrite, Converter={StaticResource BoolToIndexConverter}}">
                <ComboBoxItem Content="只补空字段" />
                <ComboBoxItem Content="覆盖已有值" />
            </ComboBox>
            <Button Grid.Column="2" Content="开始刮削" Command="{Binding StartCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ProgressText}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <DataGrid Grid.Row="2" Style="{StaticResource AppDataGridStyle}" IsReadOnly="False"
                  ItemsSource="{Binding Rows}" RowHeight="28">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="应用" Binding="{Binding Apply, Mode=TwoWay}" Width="46" />
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="190" IsReadOnly="True" />
                <DataGridTextColumn Header="类型" Binding="{Binding Genre}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="区域" Binding="{Binding Region}" Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="语言" Binding="{Binding Language}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="年份" Binding="{Binding YearText}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="发行商" Binding="{Binding Publisher}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="开发商" Binding="{Binding Developer}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="简介" Binding="{Binding Summary}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="160" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,12,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="88" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="应用" Width="88" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Apply_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
