<Window x:Class="MicaRomManager.Views.DeviceSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发送到设备"
        Width="840" Height="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}"
        Closing="OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}"
                   Text="把选中游戏复制到 U 盘 / 掌机存储卡" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="设备配置" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" MinHeight="28"
                      ItemsSource="{Binding Profiles}" DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="目标盘符" Style="{StaticResource FieldLabelStyle}" />
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Width="230" MinHeight="28" ItemsSource="{Binding Drives}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" />
                <Button Content="刷新" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshDrivesCommand}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="目标位置" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                       Text="{Binding TargetPreview}" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

            <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                      Content="同名文件覆盖（默认跳过已存在的文件）"
                      IsChecked="{Binding OverwriteSameName}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="说明" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="只复制 ROM 文件，不动原库；多碟游戏的全部碟片一起发送。目录规则来自「设置 → 设备」里选中的配置。" />
        </Grid>

        <DataGrid Grid.Row="2" Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="游戏" Binding="{Binding Title}" Width="*"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="120"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="240"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="150"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding EstimateText}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding SpaceText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0"
                         Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="打开目标目录" Width="120" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenTargetCommand}" />
            <Button Content="开始发送" Width="110" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding StartSendCommand}" IsEnabled="{Binding CanStart}"
                    Margin="8,0,0,0" />
            <Button Content="关闭" Width="88" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
