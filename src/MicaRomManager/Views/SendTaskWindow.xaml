<Window x:Class="MicaRomManager.Views.SendTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发送任务"
        Width="920" Height="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="发送任务" VerticalAlignment="Center" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="每个游戏按顺序在后台处理，不阻塞主界面；关闭窗口不影响任务继续执行。" />
        </DockPanel>

        <DataGrid Grid.Row="1" Style="{StaticResource AppDataGridStyle}"
                  ItemsSource="{Binding Tasks}"
                  SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="游戏" Binding="{Binding Title}" Width="*"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="110"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="文件" Binding="{Binding FileText}" Width="150"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="86"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="86"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTemplateColumn Header="进度" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <ProgressBar Width="96" Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding Progress}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProgressText}" Margin="6,0,0,0" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="200"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="打开所选目标目录" Width="140" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenTargetCommand}" />
            <Button Content="清空已完成" Width="110" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ClearFinishedCommand}" Margin="8,0,0,0" />
            <Button Content="关闭" Width="88" Style="{StaticResource SecondaryButtonStyle}"
                    Click="Close_Click" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
