<UserControl x:Class="MicaRomManager.Views.EmulatorManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Emulators}"
                     SelectedItem="{Binding SelectedEmulator, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Version}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="新增" Width="76" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AddEmulatorCommand}" />
                <Button Content="刷新" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshListCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Style="{StaticResource SectionTitleStyle}"
                       Text="{Binding SelectedEmulator.Name, FallbackValue=（未选择模拟器）, TargetNullValue=（未选择模拟器）}" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="安装目录" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedEmulator.InstallDir}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="可执行文件" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedEmulator.ResolvedExeDisplay}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="版本" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                           Text="{Binding SelectedEmulator.Version}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="支持格式" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedEmulator.SupportedExt}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="GitHub 仓库" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedEmulator.GithubRepo}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="官网 / 发布页" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedEmulator.WebsiteUrl}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="状态" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedEmulator.EnabledDisplay}" />
            </Grid>

            <WrapPanel Margin="0,16,0,0">
                <Button Content="导入（文件夹）" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding InstallFromFolderCommand}" />
                <Button Content="导入（压缩包）" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding InstallFromArchiveCommand}" />
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0">
                <Button Content="运行调试" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding TestLaunchCommand}" />
                <Button Content="打开安装目录" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenInstallDirCommand}" />
                <Button Content="编辑配置" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding EditSelectedCommand}" />
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0">
                <Button Content="检查更新" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CheckUpdateCommand}" />
                <Button Content="打开官网" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenWebsiteCommand}" />
                <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DeleteSelectedCommand}" />
            </WrapPanel>

            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="启动参数在「设置 → 平台」里按平台配置；这里负责程序文件、官网与 GitHub 更新。导入支持文件夹、zip、7z、rar、tar.gz / tgz。" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Width="140" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"
                         Maximum="100" Value="{Binding DownloadProgress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Button Grid.Column="2" Content="取消下载" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelUpdateCommand}"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
