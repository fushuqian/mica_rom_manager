<UserControl x:Class="MicaRomManager.Views.GameInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="InspLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="InspBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="InspCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="KvKey" TargetType="TextBlock">
            <Setter Property="Width" Value="58" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style x:Key="KvVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- 标题行：详情靠左，保存标记靠右 -->
            <Grid Grid.Row="0" Margin="16,0,14,0">
                <TextBlock x:Name="HeaderText" Text="详情" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel x:Name="DirtyBadge" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse Width="6" Height="6" Fill="#FF9F0A" Margin="0,0,6,0" />
                    <TextBlock Text="未保存" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource HairlineBrush}" />

            <!-- 只读 -->
            <ScrollViewer x:Name="ReadPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="16,14,14,8">
                <StackPanel>
                    <StackPanel x:Name="ReadEmpty" Visibility="Collapsed">
                        <TextBlock Text="在列表里双击一个游戏查看详情" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="ReadBody">
                        <DockPanel>
                            <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource InputBrush}"
                                    ClipToBounds="True" DockPanel.Dock="Left" Margin="0,0,12,0">
                                <Image x:Name="CoverImage" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ReadTitle" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ReadSubtitle" FontSize="11.5" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,14,0,6" />

                        <StackPanel x:Name="ReadKvList" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 编辑 -->
            <ScrollViewer x:Name="EditPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="16,12,14,8" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="150" Margin="0,0,8,0">
                            <TextBlock Text="标题" Style="{StaticResource InspLabel}" />
                            <TextBox x:Name="EditTitle" Style="{StaticResource InspBox}" TextChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Width="84">
                            <TextBlock Text="年份" Style="{StaticResource InspLabel}" />
                            <TextBox x:Name="EditYear" Style="{StaticResource InspBox}" TextChanged="Field_Changed" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Width="118" Margin="0,0,8,0">
                            <TextBlock Text="平台" Style="{StaticResource InspLabel}" />
                            <ComboBox x:Name="EditPlatform" Style="{StaticResource InspCombo}" IsEditable="True"
                                      SelectionChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Width="116">
                            <TextBlock Text="类型" Style="{StaticResource InspLabel}" />
                            <TextBox x:Name="EditGenre" Style="{StaticResource InspBox}" TextChanged="Field_Changed" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Width="118" Margin="0,0,8,0">
                            <TextBlock Text="区域" Style="{StaticResource InspLabel}" />
                            <ComboBox x:Name="EditRegion" Style="{StaticResource InspCombo}" IsEditable="True"
                                      SelectionChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Width="116">
                            <TextBlock Text="语言" Style="{StaticResource InspLabel}" />
                            <ComboBox x:Name="EditLanguage" Style="{StaticResource InspCombo}" IsEditable="True"
                                      SelectionChanged="Field_Changed" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Width="118" Margin="0,0,8,0">
                            <TextBlock Text="发行商" Style="{StaticResource InspLabel}" />
                            <TextBox x:Name="EditPublisher" Style="{StaticResource InspBox}" TextChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Width="116">
                            <TextBlock Text="开发商" Style="{StaticResource InspLabel}" />
                            <TextBox x:Name="EditDeveloper" Style="{StaticResource InspBox}" TextChanged="Field_Changed" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Width="118" Margin="0,0,8,0">
                            <TextBlock Text="状态" Style="{StaticResource InspLabel}" />
                            <ComboBox x:Name="EditStatus" Style="{StaticResource InspCombo}"
                                      SelectionChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Width="116">
                            <TextBlock Text="评分" Style="{StaticResource InspLabel}" />
                            <StackPanel x:Name="RatingStarsPanel" Orientation="Horizontal" Margin="2,5,0,0">
                                <TextBlock Text="☆" FontSize="15" Tag="1" Cursor="Hand"
                                           MouseLeftButtonUp="RatingStar_Click" />
                                <TextBlock Text="☆" FontSize="15" Tag="2" Cursor="Hand" Margin="2,0,0,0"
                                           MouseLeftButtonUp="RatingStar_Click" />
                                <TextBlock Text="☆" FontSize="15" Tag="3" Cursor="Hand" Margin="2,0,0,0"
                                           MouseLeftButtonUp="RatingStar_Click" />
                                <TextBlock Text="☆" FontSize="15" Tag="4" Cursor="Hand" Margin="2,0,0,0"
                                           MouseLeftButtonUp="RatingStar_Click" />
                                <TextBlock Text="☆" FontSize="15" Tag="5" Cursor="Hand" Margin="2,0,0,0"
                                           MouseLeftButtonUp="RatingStar_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="标签（逗号分隔）" Style="{StaticResource InspLabel}" />
                        <TextBox x:Name="EditTags" Style="{StaticResource InspBox}" TextChanged="Field_Changed" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="备注" Style="{StaticResource InspLabel}" />
                        <TextBox x:Name="EditNotes" Style="{StaticResource InspBox}" MinHeight="54"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 TextChanged="Field_Changed" />
                    </StackPanel>

                    <TextBlock x:Name="ScrapeStatus" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 只读底栏 -->
            <Grid x:Name="ReadFooter" Grid.Row="2" Margin="16,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding LaunchSelectedCommand}"
                        Style="{StaticResource BarPrimaryButtonStyle}" Height="34" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="开始游戏" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding ShareSelectedCommand}"
                        Style="{StaticResource ChipButtonStyle}" Height="34" Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="分享" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 编辑底栏：左刮削、右取消保存 -->
            <Grid x:Name="EditFooter" Grid.Row="2" Margin="14,0,12,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="ScrapeButton" Click="Scrape_Click" Height="32" Padding="11,0"
                            Style="{StaticResource BarPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2726;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="AI 刮削" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScrapeModeButton" Click="ScrapeMode_Click" Height="32" Padding="7,0"
                            Style="{StaticResource ChipButtonStyle}" Margin="4,0,0,0"
                            ToolTip="切换补全方式">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" FontSize="8" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ModeFillEmpty" Header="只补空字段" Click="ModeFillEmpty_Click" />
                                <MenuItem x:Name="ModeOverwrite" Header="覆盖已有" Click="ModeOverwrite_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Click="Cancel_Click" Height="32" Padding="13,0"
                            Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="保存" Click="Save_Click" Height="32" Padding="16,0"
                            Style="{StaticResource BarPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
