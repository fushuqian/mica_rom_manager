<UserControl x:Class="MicaRomManager.Controls.FluentTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48" Background="Transparent">
    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource TextPrimaryBrush}">
                <TextBlock Text="M" Foreground="{DynamicResource PanelBrush}" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
            <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                    Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化"
                    Click="Minimize_Click" />
            <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}"
                    Content="&#xE922;" ToolTip="最大化" AutomationProperties.Name="最大化"
                    Click="Maximize_Click" />
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}"
                    Content="&#xE8BB;" ToolTip="关闭" AutomationProperties.Name="关闭"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</UserControl>
