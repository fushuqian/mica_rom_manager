<UserControl x:Class="MicaRomManager.Controls.MultiSelectComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <Border x:Name="Box" MinHeight="26" Background="Transparent" BorderThickness="0"
            PreviewMouseLeftButtonDown="Box_PreviewDown" Cursor="Hand">
        <TextBlock x:Name="DisplayText" Margin="8,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </Border>
</UserControl>
