<Window x:Class="MicaRomManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaRomManager.Controls"
        Title="Mica ROM Manager"
        Width="1280" Height="780"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource WindowBackgroundBrush}"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ToolButtonStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MICA ROM MANAGER" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               Margin="0,0,18,0" Foreground="{StaticResource AccentBrush}" />
                    <Button Command="{Binding ImportCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="导入…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewGameCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="新建条目" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BatchEditCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="批量编辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LaunchSelectedCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="启动游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShareSelectedCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="分享打包" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SendSelectedCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="发送到设备" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSelectedFolderCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="打开目录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshStatusCommand}" Style="{StaticResource ToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 左侧平台列表 + 右侧筛选与游戏列表 -->
        <Grid Grid.Row="1" Margin="12,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="平台" Style="{StaticResource SectionTitleStyle}"
                               Margin="4,2,0,8" />
                    <ListBox x:Name="PlatformSidebar" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding PlatformFilters}"
                             SelectedItem="{Binding SelectedPlatformFilter, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinWidth="150">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 细筛 -->
                <Border Grid.Row="0" Padding="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding CountText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" />
                        <WrapPanel>
                            <TextBox x:Name="SearchBox" Width="220" Margin="0,0,8,4"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                     ToolTip="搜索标题、文件名、路径、标签、开发商（Ctrl+F）" />
                            <ComboBox Style="{StaticResource ToolbarComboBoxStyle}" Width="104"
                                      ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" />
                            <ComboBox Style="{StaticResource ToolbarComboBoxStyle}" Width="104"
                                      ItemsSource="{Binding RegionFilters}" SelectedItem="{Binding SelectedRegion}"
                                      ToolTip="区域" />
                            <ComboBox Style="{StaticResource ToolbarComboBoxStyle}" Width="104"
                                      ItemsSource="{Binding LanguageFilters}" SelectedItem="{Binding SelectedLanguage}"
                                      ToolTip="语言" />
                            <ComboBox Style="{StaticResource ToolbarComboBoxStyle}" Width="120"
                                      ItemsSource="{Binding DeveloperFilters}" SelectedItem="{Binding SelectedDeveloper}"
                                      ToolTip="开发商" />
                            <ComboBox Style="{StaticResource ToolbarComboBoxStyle}" Width="110"
                                      ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" />
                            <CheckBox x:Name="EditModeToggle" Content="编辑模式" IsChecked="False"
                                      Checked="OnEditModeChanged" Unchecked="OnEditModeChanged"
                                      ToolTip="开启后可直接在列表里修改单元格内容，回车或点击其他格即保存" />
                            <CheckBox Content="仅收藏" IsChecked="{Binding OnlyFavorites}" />
                            <CheckBox Content="仅缺失文件" IsChecked="{Binding OnlyMissing}" />
                            <Button Content="清除筛选" Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding ClearFiltersCommand}" />
                        </WrapPanel>
                    </DockPanel>
                </Border>

        <!-- 游戏列表 -->
        <DataGrid x:Name="GameGrid" Grid.Row="1"
                  Style="{StaticResource AppDataGridStyle}" RowHeight="28" IsReadOnly="True"
                  Tag="{Binding IsChecked, ElementName=EditModeToggle}"
                  ItemsSource="{Binding GamesView}"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnRowDoubleClick"
                  CellEditEnding="OnCellEditEnding"
                  RowEditEnding="OnRowEditEnding"
                  CurrentCellChanged="OnCurrentCellChanged"
                  ContextMenuOpening="OnContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="启动游戏" Command="{Binding LaunchSelectedCommand}" InputGestureText="Enter" />
                    <MenuItem Header="用指定模拟器启动" />
                    <MenuItem Header="编辑信息…" Command="{Binding EditSelectedCommand}" InputGestureText="F2" />
                    <MenuItem Header="批量编辑…" Command="{Binding BatchEditCommand}" />
                    <MenuItem Header="合并为多碟游戏（选中多行，首行为主条目）" Command="{Binding MergeSelectedCommand}" />
                    <MenuItem Header="拆分多碟…" Command="{Binding SplitMultiDiscCommand}" />
                    <Separator />
                    <MenuItem Header="分享打包…" Command="{Binding ShareSelectedCommand}" />
                    <MenuItem Header="发送到设备…" Command="{Binding SendSelectedCommand}" />
                    <MenuItem Header="打开所在文件夹" Command="{Binding OpenSelectedFolderCommand}" />
                    <MenuItem Header="复制文件路径" Command="{Binding CopySelectedPathCommand}" />
                    <MenuItem Header="设置封面…" Command="{Binding SetCoverCommand}" />
                    <MenuItem Header="收藏 / 取消收藏" Command="{Binding ToggleFavoriteCommand}" />
                    <MenuItem Header="刷新文件状态" Command="{Binding RefreshStatusCommand}" />
                    <Separator />
                    <MenuItem Header="从库中移除（不删文件）" Command="{Binding RemoveSelectedCommand}" />
                    <MenuItem Header="移到回收站并移除" Command="{Binding RecycleSelectedCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="★" Binding="{Binding FavoriteDisplay}" Width="36"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTemplateColumn Header="平台" Width="110" SortMemberPath="Platform">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Platform}" VerticalAlignment="Center" Margin="8,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" MinHeight="22" Padding="2,0"
                                      ItemsSource="{Binding DataContext.Platforms, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="220"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTemplateColumn x:Name="RatingColumn" Header="评分" Width="104" SortMemberPath="Rating">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock FontSize="13" Cursor="Hand" Tag="1" MouseLeftButtonUp="RatingStar_Click"
                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=1}"
                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=1}" />
                                <TextBlock FontSize="13" Cursor="Hand" Tag="2" MouseLeftButtonUp="RatingStar_Click"
                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=2}"
                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=2}" />
                                <TextBlock FontSize="13" Cursor="Hand" Tag="3" MouseLeftButtonUp="RatingStar_Click"
                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=3}"
                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=3}" />
                                <TextBlock FontSize="13" Cursor="Hand" Tag="4" MouseLeftButtonUp="RatingStar_Click"
                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=4}"
                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=4}" />
                                <TextBlock FontSize="13" Cursor="Hand" Tag="5" MouseLeftButtonUp="RatingStar_Click"
                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=5}"
                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=5}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="区域" Width="64" SortMemberPath="Region">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Region}" VerticalAlignment="Center" Margin="8,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" MinHeight="22" Padding="2,0"
                                      ItemsSource="{Binding DataContext.Regions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="语言" Width="86" SortMemberPath="Language">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Language}" VerticalAlignment="Center" Margin="8,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" MinHeight="22" Padding="2,0"
                                      ItemsSource="{Binding DataContext.Languages, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="特注" Binding="{Binding SpecialNote}" Width="96"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="类型" Binding="{Binding Genre}" Width="90"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="年份" Binding="{Binding ReleaseYear}" Width="64"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="光碟数" Binding="{Binding DiscCountText}" Width="60" SortMemberPath="DiscCount"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="60" SortMemberPath="Format"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTemplateColumn Header="状态" Width="76" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox MinHeight="22" Padding="2,0"
                                      ItemsSource="{Binding DataContext.EditStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Status, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="次数" Binding="{Binding PlayCount}" Width="56"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="时长" Binding="{Binding PlaySecondsDisplay}" Width="72" SortMemberPath="PlaySeconds"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="最近游玩" Binding="{Binding LastPlayedDisplay}" Width="124" SortMemberPath="LastPlayedAt"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="82" SortMemberPath="FileSize"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="标签" Binding="{Binding Tags}" Width="120"
                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                <DataGridTextColumn Header="指纹" Binding="{Binding RomHash}" Width="340"
                                    SortMemberPath="RomHash"
                                    ElementStyle="{StaticResource DataGridTextStyle}">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource GameCellStyle}">
                            <Setter Property="ToolTip" Value="{Binding RomPath}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DataPathText}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Margin="16,0"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="2" Width="110" Height="4" VerticalAlignment="Center"
                             IsIndeterminate="True" Margin="0,0,12,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="3" Text="{Binding LastRefreshText}"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

