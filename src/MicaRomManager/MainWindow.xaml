<Window x:Class="MicaRomManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicaRomManager.Controls"
        xmlns:views="clr-namespace:MicaRomManager.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mica ROM Manager"
        Width="1280" Height="780"
        MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseDown="OnWindowPreviewMouseDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="-1" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- WindowChrome 最大化时会向外溢出一圈，向内收 6px 避免贴边被裁 -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4" Background="{DynamicResource ShellScrimBrush}" IsHitTestVisible="False" />

        <controls:FluentTitleBar Grid.Row="0" Title="Mica ROM Manager" />

        <!-- 命令栏：库操作靠左；米卡助手 / 设备 / 设置靠右，发丝线分组 -->
        <Grid Grid.Row="1" Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ImportCommand}" Style="{StaticResource BarPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="导入游戏" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding LaunchSelectedCommand}" Style="{StaticResource BarButtonStyle}" Margin="4,0,2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="启动" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SendSelectedCommand}" Style="{StaticResource BarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="发送到设备" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenTaskListCommand}" Style="{StaticResource BarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="任务" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ToggleAssistant_Click" Style="{StaticResource BarButtonStyle}"
                        ToolTip="打开 / 收起米卡助手">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="米卡助手" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="{DynamicResource HairlineBrush}" Margin="10,0" />

                <Border Background="{DynamicResource InputBrush}" CornerRadius="11" Padding="9,4" Margin="0,0,6,0"
                        ToolTip="{Binding ConnectionText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConnection}" Value="True">
                                            <Setter Property="Fill" Value="#30D158" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" MaxWidth="150" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Command="{Binding ConnectDeviceCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButtonStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE703;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="断开" Command="{Binding DisconnectDeviceCommand}"
                        Style="{StaticResource BarButtonStyle}" FontSize="12"
                        Visibility="{Binding HasConnection, Converter={StaticResource BoolToVis}}" />

                <Border Width="1" Height="20" Background="{DynamicResource HairlineBrush}" Margin="10,0" />

                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource BarButtonStyle}" Padding="9,0"
                        ToolTip="设置" AutomationProperties.Name="设置">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 三栏平面：侧栏 / 列表 / 助手，发丝线分区，悬停浮起 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：平台列表 -->
            <Grid Grid.Column="0" x:Name="SideHost"
                  MouseEnter="SideHost_MouseEnter" MouseLeave="SideHost_MouseLeave">

                <Border x:Name="SideShadow" Background="{DynamicResource ShellPanelLiftBrush}" Opacity="0"
                        Effect="{StaticResource PanelShadowEffect}" IsHitTestVisible="False" />
                <Border Background="{DynamicResource ShellPanelBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,6">
                            <TextBlock Text="平台" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CountText}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ListBox x:Name="PlatformSidebar" Style="{StaticResource SideNavListStyle}"
                                 ItemsSource="{Binding PlatformFilters}"
                                 SelectedItem="{Binding SelectedPlatformFilter, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel MinWidth="120">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource HairlineBrush}" />

            <!-- 中间：筛选条 + 列表 -->
            <Grid Grid.Column="2" x:Name="MainHost"
                  MouseEnter="MainHost_MouseEnter" MouseLeave="MainHost_MouseLeave">

                <Border x:Name="MainShadow" Background="{DynamicResource MainPanelLiftBrush}" Opacity="0"
                        Effect="{StaticResource PanelShadowEffect}" IsHitTestVisible="False" />
                <Border Background="{DynamicResource MainPanelBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 筛选条：搜索 / 筛选 / 编辑 … 列 / 计数 -->
                        <Grid Grid.Row="0" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="250" Margin="0,0,10,0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                         ToolTip="搜索标题、文件名、路径、标签、开发商（Ctrl+F）" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                           Margin="11,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="搜索游戏名、文件名、标签…" Margin="32,0,0,0" IsHitTestVisible="False"
                                           FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button x:Name="FilterButton" Grid.Column="1" Click="FilterButton_Click"
                                    Style="{StaticResource ChipButtonStyle}" Height="30" Padding="10,0"
                                    ToolTip="状态、区域、语言、开发商、标签">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="筛选" VerticalAlignment="Center" />
                                    <Border Margin="7,0,0,0" MinWidth="17" Height="17" CornerRadius="8.5"
                                            Background="{DynamicResource AccentBrush}" Padding="5,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ActiveFilterCount}"
                                                   Foreground="{DynamicResource OnAccentTextBrush}" FontSize="10"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <ToggleButton x:Name="EditModeToggle" Grid.Column="2" Margin="6,0,0,0"
                                          Style="{StaticResource ChipToggleButtonStyle}"
                                          Checked="EditMode_Changed" Unchecked="EditMode_Changed"
                                          ToolTip="在右侧托盘里编辑选中游戏的元数据">
                                <TextBlock Text="编辑" VerticalAlignment="Center" />
                            </ToggleButton>

                            <Button x:Name="ColumnMenuButton" Grid.Column="4" Click="ColumnMenu_Click"
                                    Style="{StaticResource ChipButtonStyle}" Height="30" Padding="9,0"
                                    Margin="0,0,6,0" ToolTip="列设置：勾选要显示的列，配置会记住"
                                    AutomationProperties.Name="列设置">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="列" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" FontSize="8"
                                               Margin="5,1,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="{Binding CountText}">
                                <Run Text="{Binding FilteredCount}" /><Run Text=" / " /><Run Text="{Binding TotalCount}" /><Run Text=" 款" />
                            </TextBlock>
                        </Grid>

                        <!-- 外置盘未连接提示 -->
                        <Border Grid.Row="1" Padding="12,7" Margin="14,0,14,8" CornerRadius="8"
                                Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                Visibility="{Binding HasLibraryWarning, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="刷新文件状态" Margin="12,0,0,0"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Command="{Binding RefreshStatusCommand}" />
                                <TextBlock Text="{Binding LibraryWarning}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="GameGrid" Grid.Row="2" Style="{StaticResource GameGridStyleV2}"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding GamesView}"
                                  SelectionChanged="OnSelectionChanged"
                                  MouseDoubleClick="OnRowDoubleClick"
                                  CellEditEnding="OnCellEditEnding"
                                  RowEditEnding="OnRowEditEnding"
                                  CurrentCellChanged="OnCurrentCellChanged"
                                  ContextMenuOpening="OnContextMenuOpening">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="启动游戏" Command="{Binding LaunchSelectedCommand}" InputGestureText="Enter" />
                                    <MenuItem Header="用指定模拟器启动" />
                                    <MenuItem Header="编辑信息…" Command="{Binding EditSelectedCommand}" InputGestureText="F2" />
                                    <MenuItem Header="刮削信息…" Command="{Binding ScrapeCommand}" />
                                    <MenuItem Header="AI 生成标签" Command="{Binding AiTagsCommand}" />
                                    <MenuItem Header="AI 翻译" Command="{Binding AiTranslateCommand}" />
                                    <MenuItem Click="AiAsk_Click" ToolTip="把选中的游戏发送给右侧 AI 助手咨询">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#7C4DFF" Offset="0" />
                                                            <GradientStop Color="#13B5FF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="AI" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="问问" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Header="推荐游戏…" Command="{Binding RecommendCommand}" />
                                    <MenuItem Header="批量编辑…" Command="{Binding BatchEditCommand}" />
                                    <MenuItem Header="合并为多碟游戏（选中多行，首行为主条目）" Command="{Binding MergeSelectedCommand}" />
                                    <MenuItem Header="拆分多碟…" Command="{Binding SplitMultiDiscCommand}" />
                                    <Separator />
                                    <MenuItem Header="分享打包…" Command="{Binding ShareSelectedCommand}" />
                                    <MenuItem Header="发送到设备…" Command="{Binding SendSelectedCommand}" />
                                    <MenuItem Header="断开设备连接" Command="{Binding DisconnectDeviceCommand}" />
                                    <MenuItem Header="打开所在文件夹" Command="{Binding OpenSelectedFolderCommand}" />
                                    <MenuItem Header="复制文件路径" Command="{Binding CopySelectedPathCommand}" />
                                    <MenuItem Header="设置封面…" Command="{Binding SetCoverCommand}" />
                                    <MenuItem Header="收藏 / 取消收藏" Command="{Binding ToggleFavoriteCommand}" />
                                    <MenuItem Header="刷新文件状态" Command="{Binding RefreshStatusCommand}" />
                                    <Separator />
                                    <MenuItem Header="从库中移除（不删文件）" Command="{Binding RemoveSelectedCommand}" />
                                    <MenuItem Header="移到回收站并移除" Command="{Binding RecycleSelectedCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="收藏" Width="Auto" SortMemberPath="Favorite">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                                <Path Data="M7,0 L8.9,4.6 L13.9,5.1 L10.1,8.5 L11.2,13.4 L7,10.8 L2.8,13.4 L3.9,8.5 L0.1,5.1 L5.1,4.6 Z"
                                                      Fill="#FFB300" Stretch="Fill" Width="13" Height="13"
                                                      Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="标题" Width="Auto" MaxWidth="460">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="平台" Width="Auto" SortMemberPath="Platform">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Platform}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True" MinHeight="22" Padding="2,0"
                                                      ItemsSource="{Binding DataContext.Platforms, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="类型" Binding="{Binding Genre}" Width="Auto"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="年份" Binding="{Binding ReleaseYear}" Width="Auto"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="发行商" Binding="{Binding Publisher}" Width="Auto"
                                                    SortMemberPath="Publisher"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="开发商" Binding="{Binding Developer}" Width="Auto"
                                                    SortMemberPath="Developer"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTemplateColumn x:Name="RatingColumn" Header="评分" Width="Auto" SortMemberPath="Rating">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" Cursor="Hand" Tag="1" MouseLeftButtonUp="RatingStar_Click"
                                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=1}"
                                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=1}" />
                                                <TextBlock FontSize="12" Cursor="Hand" Tag="2" MouseLeftButtonUp="RatingStar_Click"
                                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=2}"
                                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=2}" />
                                                <TextBlock FontSize="12" Cursor="Hand" Tag="3" MouseLeftButtonUp="RatingStar_Click"
                                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=3}"
                                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=3}" />
                                                <TextBlock FontSize="12" Cursor="Hand" Tag="4" MouseLeftButtonUp="RatingStar_Click"
                                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=4}"
                                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=4}" />
                                                <TextBlock FontSize="12" Cursor="Hand" Tag="5" MouseLeftButtonUp="RatingStar_Click"
                                                           Text="{Binding Rating, Converter={StaticResource StarGlyphConverter}, ConverterParameter=5}"
                                                           Foreground="{Binding Rating, Converter={StaticResource StarBrushConverter}, ConverterParameter=5}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="区域" Width="Auto" SortMemberPath="Region">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Region}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True" MinHeight="22" Padding="2,0"
                                                      ItemsSource="{Binding DataContext.RegionFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="语言" Width="Auto" SortMemberPath="Language">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Language}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True" MinHeight="22" Padding="2,0"
                                                      ItemsSource="{Binding DataContext.LanguageFilters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="特注" Binding="{Binding SpecialNote}" Width="Auto"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="光碟数" Binding="{Binding DiscCountText}" Width="Auto" SortMemberPath="DiscCount"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="Auto" SortMemberPath="Format"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="选用模拟器" Binding="{Binding EmulatorDisplay}" Width="Auto"
                                                    SortMemberPath="EmulatorDisplay"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTemplateColumn Header="状态" Width="Auto" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" />
                                                <TextBlock Text="{Binding LastPlayedDisplay}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox MinHeight="22" Padding="2,0"
                                                      ItemsSource="{Binding DataContext.EditStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Status, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="次数" Binding="{Binding PlayCount}" Width="Auto"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="时长" Binding="{Binding PlaySecondsDisplay}" Width="Auto" SortMemberPath="PlaySeconds"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="Auto" SortMemberPath="FileSize"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="标签" Binding="{Binding Tags}" Width="Auto"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="Auto"
                                                    SortMemberPath="Notes"
                                                    ElementStyle="{StaticResource DataGridTextStyle}" />
                                <DataGridTextColumn Header="指纹" Binding="{Binding RomHash}" Width="Auto"
                                                    SortMemberPath="RomHash"
                                                    ElementStyle="{StaticResource DataGridTextStyle}">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource GameCellStyleV2}">
                                            <Setter Property="ToolTip" Value="{Binding RomPath}" />
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 窗口内浮层：点空白关闭，锚在按钮下方（避免 Popup 在最大化时漂移） -->
                        <Border x:Name="OverlayScrim" Grid.RowSpan="3" Background="Transparent"
                                Visibility="Collapsed" MouseDown="OverlayScrim_MouseDown" />

                        <Border x:Name="FilterFlyout" Grid.RowSpan="3" Width="372" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,52,0,0"
                                Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.20" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="筛选条件" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="条件会立即生效；可叠加使用。" FontSize="11" Margin="0,3,0,12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="状态" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="区域" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding RegionFilters}" SelectedItem="{Binding SelectedRegion}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="语言" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding LanguageFilters}" SelectedItem="{Binding SelectedLanguage}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="开发商" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding DeveloperFilters}" SelectedItem="{Binding SelectedDeveloper}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="标签" FontSize="11" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox Content="仅收藏" IsChecked="{Binding OnlyFavorites}" />
                                    <CheckBox Content="仅缺失文件" IsChecked="{Binding OnlyMissing}" Margin="16,0,0,0" />
                                </StackPanel>

                                <DockPanel Margin="0,16,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="清除筛选" Style="{StaticResource ChipButtonStyle}"
                                                Command="{Binding ClearFiltersCommand}" Margin="0,0,4,0" />
                                        <Button Content="完成" Style="{StaticResource BarPrimaryButtonStyle}"
                                                Click="CloseOverlays_Click" Width="72" />
                                    </StackPanel>
                                    <TextBlock Text="筛选条件会随视图状态保存" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ColumnFlyout" Grid.RowSpan="3" Width="300" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,10,0"
                                Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.20" />
                            </Border.Effect>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="列设置" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Top" Text="勾选要显示的列，配置会记住；至少保留一列。"
                                           FontSize="11" Margin="0,3,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="全部显示" Click="ColumnsShowAll_Click"
                                            Style="{StaticResource ChipButtonStyle}" />
                                    <Button Content="恢复默认" Click="ColumnsReset_Click" Margin="6,0,0,0"
                                            Style="{StaticResource ChipButtonStyle}" />
                                    <Button Content="完成" Click="CloseOverlays_Click" Width="64"
                                            Style="{StaticResource BarPrimaryButtonStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ColumnCheckHost" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="3" Background="{DynamicResource HairlineBrush}" />

            <!-- 右侧：米卡助手；详情/编辑托盘占用同一格并盖在其上 -->
            <Grid Grid.Column="4">
                <Border x:Name="AssistantHost" Width="0" ClipToBounds="True"
                        Background="{DynamicResource ShellPanelBrush}">
                    <views:AiAssistantView x:Name="AssistantPanel" Width="300" Visibility="Collapsed"
                                           HorizontalAlignment="Right" />
                </Border>

                <Border x:Name="InspectorTray" Width="300" HorizontalAlignment="Right"
                        Visibility="Collapsed" Background="{DynamicResource TrayBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                    <views:GameInspectorView x:Name="Inspector" />
                </Border>
            </Grid>
        </Grid>


        <!-- 状态栏 -->
        <Grid Grid.Row="3" Margin="20,0" ToolTip="{Binding DataPathText}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="460" />
            <ProgressBar Grid.Column="1" Width="100" Height="3" VerticalAlignment="Center"
                         IsIndeterminate="True" Margin="10,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="11" Margin="12,0,16,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding LastRefreshText}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
