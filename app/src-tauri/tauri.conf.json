{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicaRomManager",
  "version": "0.14.0",
  "identifier": "com.fushuqian.micarommanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mica ROM Manager",
        "width": 1280,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["Resources/EmulatorTemplates.json"]
  }
}
